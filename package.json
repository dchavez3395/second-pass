{
  "name": "second-pass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Baseline axe-core audit of Manitoba public sector sites. Phase 01 of Second Pass.",
  "scripts": {
    "setup": "playwright install chromium",
    "smoke": "node audit.mjs --limit 3",
    "audit": "node audit.mjs",
    "audit:deep": "node audit.mjs --interior 2",
    "diagnose": "node diagnose.mjs",
    "diagnose:slow": "node diagnose.mjs --wait 15000",
    "review": "node review.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "playwright": "^1.50.0"
  }
}
